# Copiar a .env.local y llenar con los valores reales.
# Ninguna de estas keys se manda al navegador -- solo se usan en rutas de servidor de Next.js.

SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Secreto para firmar la cookie de sesión del admin (cualquier cadena larga y aleatoria).
SESSION_SECRET=

# Número de WhatsApp de respaldo si config.whatsapp_numero no está seteado aún (formato: 52XXXXXXXXXX, sin +).
WHATSAPP_NUMERO_DEFAULT=

# URL pública del sitio (para armar links en el mensaje de WhatsApp y en las etiquetas Open Graph).
SITE_URL=https://tienda-hellcomics.vercel.app
